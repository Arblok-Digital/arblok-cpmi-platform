# Frontend-only configuration.
# NEVER put a service_role/secret key, database password, or any secret in VITE_* variables.
#
# Leave these empty to run the app in Demo Mode (synthetic data, local persistence).
# Fill them to connect the Supabase adapter once migrations are applied.
#
# Local stack (WSL): URL below, and copy the Publishable key printed by
# `supabase status` from inside WSL. Ports are project-specific (5632x).
# VITE_SUPABASE_URL=http://127.0.0.1:56321
# VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
